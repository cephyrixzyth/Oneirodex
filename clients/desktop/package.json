{
  "name": "oneirodex-desktop",
  "private": true,
  "version": "1.1.4",
  "description": "Oneirodex desktop companion (Tauri 2)",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:thin": "tsc --noEmit && vite build --mode thin",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "npm --prefix ../.. run lint",
    "format:check": "npm --prefix ../.. run format:check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:thin": "tauri build --config src-tauri/tauri.thin.conf.json"
  },
  "dependencies": {
    "@oneirodex/api-client": "*",
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
