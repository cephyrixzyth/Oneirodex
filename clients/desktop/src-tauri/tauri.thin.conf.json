{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneirodexThin",
  "version": "1.1.8",
  "identifier": "com.oneirodex.thin",
  "build": {
    "beforeDevCommand": "npm run build:thin",
    "beforeBuildCommand": "npm run build:thin",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oneirodex Thin",
        "width": 520,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["thin-main", "thin-library", "social"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
