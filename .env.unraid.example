# Oneirodex — Unraid Compose Manager .env template
# cp .env.unraid.example .env   then set SECRET_KEY (required — refuse placeholder)
#
# This household — live stack is the git checkout (isos/ is retired):
#   External ENV File Path:  /mnt/user/infernal-data-streams/_projects/Oneirodex/.env
#   Indirect Compose File:   /mnt/user/infernal-data-streams/_projects/Oneirodex/docker-compose.yml
#   Indirect Path:           (leave empty)
# Windows mapping of the same tree: Z:\_projects\Oneirodex
#
# docker-compose.override.yml in this tree is Windows GPU. Unraid has none —
# leave --profile artwork off, or set COMPOSE_FILE=docker-compose.yml here if
# a stack update dies with nvml error: driver not loaded.
#
# IMPORTANT volume sectioning (do NOT conflate):
#   DATA_FOLDER_GAMES  = HOST games share  → mounted RO at /storage (scan root only)
#   LIBRARY_HOST_PATH  = HOST appdata      → mounted RW at /app/oneirodex/static/library
#   EMULATOR_BIOS_HOST_PATH (optional) = HOST private firmware folder under appdata
#     → mounted RW at /app/oneirodex/static/library/bios (NOT the games share)
# Container app env hard-sets DATA_FOLDER_GAMES=/storage and UPLOAD_FOLDER=…/library;
# these .env values are for the Compose *host* bind paths only.
#
# BIOS honesty:
#   Public / GitHub image → Admin upload only (never ship firmware binaries in git,
#   CI artifacts, or Docker layers as content).
#   Local household Unraid → optional private mount of files you already legally own.
#   Filenames only in docs — no download links. Uncomment the bios volume in
#   docker-compose.yml when using EMULATOR_BIOS_HOST_PATH.
#
# Do NOT set DATABASE_URL=@localhost — Compose builds URL with host "db".

# --- Postgres (bundled `db` service) ---
POSTGRES_USER=postgres
# Postgres superuser password. SET A STRONG, UNIQUE VALUE before the first
# `docker compose up`:
#   python -c "import secrets; print(secrets.token_hex(24))"     (or: openssl rand -hex 24)
# Hex/alphanumerics only: Compose splices it into DATABASE_URL, so @ : / ? # % $
# break the URL.
# Postgres reads this ONLY when it first creates the db_data volume. On an
# existing stack, editing this line alone locks the app out of its database --
# rotate it per docs/runbooks/docker-compose-deploy.md (Postgres password).
# Left unset or blank, Compose falls back to the legacy default "postgres" so
# old stacks keep starting. That is a KNOWN password: never run it on a host
# anyone else can reach.
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_password
POSTGRES_DB=oneirodex
DATABASE_HOST=db
DATABASE_PORT=5432
# Postgres is published on 127.0.0.1 only (local pytest / tools on this host).
# Reaching it from another machine is an explicit opt-in, and only with a strong
# password above. Clients must sit in a private range (see docker/postgres/pg_hba.conf).
#   POSTGRES_HOST_BIND=192.168.1.10     # this host's LAN IP (or 0.0.0.0)
#   POSTGRES_HOST_PORT=5432

# --- Required secret ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Do not leave blank or use a documented placeholder — container refuses it.
SECRET_KEY=

# --- UNRAID VOLUMES (host paths under /mnt/user/...) ---
# Games share — read-only scan root (never uploads / covers / themes)
# Console ROM leaves live under this share, e.g. …/_console-gaming/NINTENDO/…
# (create per-platform leaf libs at /storage/… — see docs/runbooks/unraid-deploy.md)
DATA_FOLDER_GAMES=/mnt/user/games
# Appdata library — covers, themes, user uploads (RW)
LIBRARY_HOST_PATH=/mnt/user/appdata/oneirodex/library

# --- Extra scan locations (optional) ---
# A second user share, a disk share, an unassigned device. Unraid already has
# these mounted, so it is one more RO bind plus one line here. Uncomment the
# matching LIBRARY_ROOT_*_HOST_PATH bind in docker-compose.yml first.
# ONEIRODEX_LIBRARY_ROOTS / ONEIRODEX_LIBRARY_ROOTS take the CONTAINER path (/storage2), not the host path.
#   LIBRARY_ROOT_2_HOST_PATH=/mnt/user/roms
#   ONEIRODEX_LIBRARY_ROOTS=NAS ROMs=/storage2
# Compose interpolates both keys; ONEIRODEX_ wins inside the app if both are set.
# See docs/runbooks/remote-scan-locations.md
ONEIRODEX_LIBRARY_ROOTS=
ONEIRODEX_LIBRARY_ROOTS=
LIBRARY_ROOT_2_HOST_PATH=
LIBRARY_ROOT_3_HOST_PATH=
LIBRARY_ROOT_4_HOST_PATH=

# --- Optional private BIOS / firmware (household Unraid) ---
# Container path Play + Admin list (matches default bios_root / WebRetro biosCdn).
# EMULATOR_BIOS_PATH=/app/oneirodex/static/library/bios
# Host folder under appdata (legally obtained files you already own) — NOT games share.
# Create the dir, drop named BIOS files, then uncomment the bios bind in docker-compose.yml.
# EMULATOR_BIOS_HOST_PATH=/mnt/user/appdata/oneirodex/bios
# Optional: scan this folder (and subfolders) from Admin → Emulators, and import
# missing names on boot. Never overwrites files already on the volume.
# BIOS_IMPORT_SOURCE=/app/oneirodex/static/library/bios-pack

# App listens on host:5006 (compose maps 5006:5006)
# PORT is informational for operators; compose hard-binds 5006
PORT=5006
DEV_MODE=false
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
TRUSTED_PROXIES=0

# Hosts allowed to become the origin of an emailed link (password reset, invite).
# Empty trusts private/LAN hosts only, so http://192.168.x.x links keep working
# while a forged Host header cannot poison a reset email. Set this when Oneirodex
# is published on a public hostname: TRUSTED_LINK_HOSTS=games.example.com
TRUSTED_LINK_HOSTS=
# Uvicorn workers — keep 1 for SSE/schedulers on single-node Unraid
UVICORN_WORKERS=1
# Background schedulers (scan, library-watch, free-games, discover-ML, ownership,
# email-digest) start from the ASGI lifespan handler. Leave true on a single-node
# Unraid box. Default true.
ONEIRODEX_ENABLE_BACKGROUND_WORKERS=true
# Logging goes to the container log (stdout). Level: CRITICAL/ERROR/WARNING/INFO/DEBUG.
ONEIRODEX_LOG_LEVEL=INFO
# ONEIRODEX_LOG_JSON=1  # one JSON line per record if you ship logs off-box
# Optional library root-folder watch (default OFF). Best-effort on Unraid FUSE —
# see docs/runbooks/unraid-deploy.md § Library root watch.
# When on, watches libraries with last_scan_folder except watch_enabled=false.
# ONEIRODEX_LIBRARY_WATCH=0
# ONEIRODEX_LIBRARY_WATCH_DEBOUNCE_SEC=3
# ONEIRODEX_LIBRARY_ADD_NOTIFY_DEBOUNCE_SEC=5

# --- Feature defaults (household; flip as needed) ---
ENABLE_ARR_MODULE=false
ENABLE_ARR_HARDLINK_PIPELINE=false
# Remote path mapping — set this when your download client runs in a different
# container than Oneirodex. qBittorrent reports paths from ITS mounts, so
# without a mapping the hardlink pipeline stats a path that does not exist here
# and reports "no source file found" even though the file is present.
# Format: "remote=>local" pairs joined by "|".
#   ARR_REMOTE_PATH_MAP=/downloads=>/storage/downloads|/data/torrents=>/mnt/user/torrents
ARR_REMOTE_PATH_MAP=

# Unraid LAN connectors (Prowlarr/qBit/Ollama on RFC1918)
ALLOW_PRIVATE_LAN_URLS=true
ENABLE_AI_ASSIST=false
ENABLE_AI_AUTO_APPLY=false
# Generated cover art — off by default; point at your own LAN endpoint if wanted.
# Most Unraid boxes have no NVIDIA GPU, so the usual shape is: run SD.Next /
# AUTOMATIC1111 / Forge on whichever machine in the house does have one and set
#   AI_ARTWORK_URL=http://<gpu-host-lan-ip>:7860
# The backend only speaks HTTP to this URL — the generator does not have to run
# on Unraid, and with a remote one you never start --profile artwork here.
# Only if this host itself has an NVIDIA driver + Container Toolkit is the local
# GPU sidecar an option; that is docker-compose.gpu.yml, opt-in via COMPOSE_FILE.
# Requesting a GPU on a host without one fails container create outright
# ("nvml error: driver not loaded") and takes the whole stack update with it.
# SD.Next has no login: the sidecar publishes its UI on 127.0.0.1:7860 only. The
# app reaches it over the Compose network and does not need that mapping. To open
# the UI from another machine set SDNEXT_HOST_BIND=<this host's LAN IP>.
ENABLE_AI_ARTWORK=false
AI_ARTWORK_URL=
AI_ARTWORK_ENGINE=a1111
# Version / update / DLC checks after a scan (outbound store traffic — opt in)
SCAN_CHECK_FRESHNESS=false
SCAN_FRESHNESS_LIMIT=50
# Theme fonts — leave empty so uploads land in the persisted library volume
FONT_PATH=
FONT_MAX_BYTES=8388608
ENABLE_HARDLINK_HELPERS=false
ALLOW_HARDLINK_APPLY=false
ENABLE_VR_BROWSE=false
OIDC_ENABLED=false

# In-app support → GitHub Issues (no Discord / webhooks)
SUPPORT_GITHUB_TOKEN=
SUPPORT_GITHUB_REPO=cephyrixzyth/oneirodex

# =============================================================================
# PROFILE TOGGLES — start sidecars with Compose profiles (not auto-started)
# Full stack for Unraid test:
#   docker compose --profile livekit --profile clamav --profile challenge up -d
# Or enable one at a time (examples below). Grafana is NOT bundled — see
# docs/runbooks/observability-profile.md (commented stub only).
# =============================================================================

# --- profile: livekit ---
# docker compose --profile livekit up -d
# Then set LIVEKIT_URL to a browser-reachable ws:// or wss:// (LAN hostname, not 127.0.0.1 from other devices)
# LiveKit no longer runs in --dev mode, so there is no built-in devkey/secret.
# Generate a pair; the app and the SFU read these same two values:
#   python -c "import secrets; print('LIVEKIT_API_KEY=odx' + secrets.token_hex(6)); print('LIVEKIT_API_SECRET=' + secrets.token_hex(32))"
# Alphanumerics only, secret at least 32 characters. Left blank, the livekit
# container refuses to start (by design) instead of running open on :7880.
ENABLE_LIVEKIT=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVEKIT_HOST_PORT=7880

# --- profile: clamav ---
# docker compose --profile clamav up -d
# First start may take several minutes while virus defs download.
ENABLE_MALWARE_SCAN=true
MALWARE_SCAN_BLOCK_ON_HIT=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Or bind-mount host clamd socket into app and set:
# CLAMAV_SOCKET=/run/clamav/clamd.sock

# --- profile: challenge (TRAWL captcha solver) ---
# docker compose --profile challenge up -d
# No host ports — Docker network only. Reload app after enabling.
ENABLE_CHALLENGE_SOLVER=false
CHALLENGE_SOLVER_URL=http://trawl:8191
CHALLENGE_SOLVER_PROVIDER=flaresolverr_compat
CHALLENGE_SOLVER_TIMEOUT_MS=60000
CHALLENGE_SOLVER_MAX_TIER=5
# Old NAS / no AVX2:
# TRAWL_IMAGE=ghcr.io/germondai/trawl:baseline

# CSP enforces by default in config.py. Report-only: CSP_ENFORCE=false
# Optional household ownership tokens (register-only, never downloads). Used only
# for members who link a store without their own token; that account's library
# is then recorded as theirs (see docs/admin/privacy-data-handling.md):
# STEAM_WEB_API_KEY=
# GOG_REFRESH_TOKEN=
# EPIC_DEVICE_AUTH={"account_id":"","device_id":"","secret":""}
# AMAZON_REFRESH_TOKEN=
# AMAZON_DEVICE_SERIAL=
# AMAZON_NILE_JSON=
# APP_IMAGE=cephyrixzyth/oneirodex:1.0.1
# Live Unraid until FIFO-idle recreate:
# APP_CONTAINER_NAME=oneirodex-app
# DB_CONTAINER_NAME=oneirodex-db
