# Oneirodex single-container (docker-compose.single.yml). Every line is optional.
# Host path for the one appdata mount (database, secrets, logs, covers, themes)
APPDATA_PATH=./appdata
# Host games / ROMs folder, mounted read-only
DATA_FOLDER_GAMES=./games
# Unraid: 99/100 (nobody:users). Elsewhere use your own `id -u` / `id -g`.
PUID=99
PGID=100
TZ=UTC
# Extra scan locations: add a bind mount for each, then list the container paths
#ONEIRODEX_LIBRARY_ROOTS=NAS ROMs=/storage2
# Use an external Postgres instead of the embedded one:
#   set DATABASE_URL=postgresql://user:pass@host:5432/oneirodex
# Force the embedded one even if DATABASE_URL is set: ONEIRODEX_EMBEDDED_DB=true
