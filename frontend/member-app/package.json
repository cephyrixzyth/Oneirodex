{
  "name": "member-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm --prefix ../.. run lint",
    "format:check": "npm --prefix ../.. run format:check",
    "lint:css": "node ../../scripts/css-token-lint.mjs",
    "lint:css:update": "node ../../scripts/css-token-lint.mjs --update"
  },
  "dependencies": {
    "@oneirodex/api-client": "*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "cmdk": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.9.3",
    "jsdom": "^26.1.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
