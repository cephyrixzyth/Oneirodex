{
  "name": "admin-app",
  "private": true,
  "version": "1.1.5",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm --prefix ../.. run lint",
    "format:check": "npm --prefix ../.. run format:check"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
