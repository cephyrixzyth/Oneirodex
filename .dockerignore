# Desktop companion (Tauri) — not part of the server image
clients/
**/src-tauri/target/
# ...but the desktop workspace manifest is needed in the frontend-build stage:
# the root `npm ci` validates every workspace in the root lockfile, and
# clients/desktop is one of them. Just the manifest, none of the Tauri sources.
!clients/desktop/package.json

# Host-built SPA bundles (image builds them in frontend-build stage)
oneirodex/static/dist/

# Private vault (never ship)
docs/_private/

# Operator BIOS staging from scripts/import_bios.py (never bake dumps into the image)
.bios-install-out/
bios/
**/bios/*.bin
**/bios/*.rom
oneirodex/static/library/bios/

