# Oneirodex environment example
#
# Docker / Unraid Compose:
#   Prefer copying .env.unraid.example (Unraid), .env.docker.example, or .env.nas.example
#   instead of this file.
#   Compose always connects to the "db" service (never localhost inside the container).
#
# Native (non-Docker) install on the same machine as Postgres:
#   DATABASE_URL=postgresql://oneirodexuser:<password>@localhost:5432/oneirodex

# --- Native / local Postgres (non-Docker) ---
# Use a dedicated role with its own strong password, not the `postgres`
# superuser and not a well-known pair such as postgres:postgres.
# install-linux.sh creates `oneirodexuser` and writes the real URL into .env
# for you. The one exception is the throwaway docker-compose.review.yml
# database (loopback-only, test data): docs/runbooks/local-postgres-pytest.md.
DATABASE_URL=postgresql://oneirodexuser:CHANGE_ME_DB_PASSWORD@localhost:5432/oneirodex
TEST_DATABASE_URL=postgresql://oneirodexuser:CHANGE_ME_DB_PASSWORD@localhost:5432/oneirodextest

# --- Docker Compose uses these (host paths for volume mounts) ---
# DATA_FOLDER_GAMES is the HOST path; compose mounts it to /storage in the container.
DATA_FOLDER_GAMES=/path/to/your/games

# Extra scan locations beyond DATA_FOLDER_GAMES: a NAS share, a second disk,
# an external drive. Oneirodex scans anything this machine can open, so the
# share must already be mounted here — mounting it is an OS-level step.
# Pipe-separated; each entry may carry a "Label=" prefix for the folder browser.
#   ONEIRODEX_LIBRARY_ROOTS=NAS ROMs=/mnt/nas/roms|Archive=/mnt/archive/games
# Windows: prefer UNC paths over mapped drive letters (mapped drives are
# per-user and do not exist for a service). See:
# docs/runbooks/remote-scan-locations.md
ONEIRODEX_LIBRARY_ROOTS=
LIBRARY_HOST_PATH=./data/library
# Optional household BIOS mount (Compose) — appdata host path, not games.
# Prefer .env.unraid.example. Never commit firmware binaries.
# EMULATOR_BIOS_PATH=/app/oneirodex/static/library/bios
# EMULATOR_BIOS_HOST_PATH=/mnt/user/appdata/oneirodex/bios
BASE_FOLDER_WINDOWS=C:\
BASE_FOLDER_POSIX=/

SECRET_KEY=put_your_own_secret_string_here_32617432
UPLOAD_FOLDER=./oneirodex/static/library
# Standalone installs only (ADR 0011): put everything the server writes
# (themes, icon packs, artwork, saves, fonts, caches) in this folder instead of
# oneirodex/static/library. Still served at /static/library/. The standalone
# launcher sets it; leave it unset for Docker and native installs.
# ONEIRODEX_LIBRARY_DIR=
DEV_MODE=false
PORT=5006
# Uvicorn workers (Docker entrypoint). Default 1 for SSE/schedulers; override to 2 OK.
UVICORN_WORKERS=1
# How long Uvicorn waits for active requests during SIGTERM before cancelling them (seconds).
UVICORN_GRACEFUL_TIMEOUT=5
# Background schedulers (scan, library-watch, free-games, discover-ML, ownership,
# email-digest) start from the ASGI lifespan handler. Set false for a web-only
# process. Default true.
ONEIRODEX_ENABLE_BACKGROUND_WORKERS=true
# Logging (stdlib logging, configured in oneirodex/utils/logging_setup.py).
# Console handler on stdout — Docker/Unraid capture that. Level is one of
# CRITICAL/ERROR/WARNING/INFO/DEBUG (anything else falls back to INFO).
ONEIRODEX_LOG_LEVEL=INFO
# Set to 1 for one JSON object per line (for a log shipper); default is the
# human console format with a per-request correlation id.
# ONEIRODEX_LOG_JSON=0
# Background work hard caps (prevent scan/image turbo from pinning Unraid CPU)
# ONEIRODEX_SCAN_THREAD_CAP=4
# ONEIRODEX_IMAGE_DOWNLOAD_THREAD_CAP=4
# ONEIRODEX_IMAGE_DOWNLOAD_BATCH_CAP=100
# ONEIRODEX_WORKER_YIELD_MS=5
# Optional library root-folder incremental watch (default OFF). When 1, watches
# each library last_scan_folder except libraries with watch_enabled=false
# (per-lib opt-out). Scan-depth–aware leaf folders only; not deep arcade ROM
# trees. Debounces 2–5s and enqueues ScanJobs via the FIFO queue.
# Unraid FUSE/bind-mount may miss host-side renames — see unraid-deploy.md.
# ONEIRODEX_LIBRARY_WATCH=0
# ONEIRODEX_LIBRARY_WATCH_DEBOUNCE_SEC=3
# Optional debounce for library-added staff digests (seconds, 2–30; default 5):
# ONEIRODEX_LIBRARY_ADD_NOTIFY_DEBOUNCE_SEC=5
# See docs/runbooks/unraid-deploy.md § Library root watch
# See docs/admin/library-root-watch-spike.md

POSTGRES_USER=postgres
# Postgres superuser password. SET A STRONG, UNIQUE VALUE before the first
# `docker compose up`:
#   python -c "import secrets; print(secrets.token_hex(24))"     (or: openssl rand -hex 24)
# Hex/alphanumerics only: Compose splices it into DATABASE_URL, so @ : / ? # % $
# break the URL.
# Postgres reads this ONLY when it first creates the db_data volume. On an
# existing stack, editing this line alone locks the app out of its database --
# rotate it per docs/runbooks/docker-compose-deploy.md (Postgres password).
# Left unset or blank, Compose falls back to the legacy default "postgres" so
# old stacks keep starting. That is a KNOWN password: never run it on a host
# anyone else can reach.
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_password
POSTGRES_DB=oneirodex
DATABASE_HOST=db
DATABASE_PORT=5432
# Postgres is published on 127.0.0.1 only (local pytest / tools on this host).
# Reaching it from another machine is an explicit opt-in, and only with a strong
# password above. Clients must sit in a private range (see docker/postgres/pg_hba.conf).
#   POSTGRES_HOST_BIND=192.168.1.10     # this host's LAN IP (or 0.0.0.0)
#   POSTGRES_HOST_PORT=5432

# OIDC / SSO (optional — local login always works)
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://auth.example.com/application/o/oneirodex/
OIDC_CLIENT_ID=oneirodex
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://oneirodex.example.com/login/oidc/callback
OIDC_SCOPES=openid email profile groups
OIDC_ROLE_CLAIM=groups
OIDC_ROLE_MAP={"admin":"admin","oneirodex-admin":"admin","oneirodex-admin":"admin","librarian":"librarian","oneirodex-librarian":"librarian","oneirodex-librarian":"librarian","child":"child","oneirodex-child":"child","oneirodex-child":"child"}
OIDC_DISPLAY_NAME=Sign in with SSO

# Session cookies — false for local HTTP; true behind HTTPS
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
TRUSTED_PROXIES=0

# Hosts allowed to become the origin of an emailed link (password reset, invite).
# Leave empty on a LAN install: private/loopback hosts are trusted by default, so
# http://192.168.x.x:5006 links keep working while a forged Host header does not.
# Set it when Oneirodex is published on a public hostname, comma separated with an
# optional port: TRUSTED_LINK_HOSTS=games.example.com,10.0.0.5:5006
TRUSTED_LINK_HOSTS=

# Security response headers. nosniff / frame / referrer / permissions are always
# sent. CSP is on and **enforcing** by default. Classic onclick= is gone; WebRetro
# WASM is served as /static/* with baseline headers only (no CSP). Set
# CSP_ENFORCE=false to report without blocking.
CSP_ENABLED=true
CSP_ENFORCE=true
# HSTS is only sent when SESSION_COOKIE_SECURE=true. 0 disables it.
HSTS_SECONDS=31536000

# Global request-body ceiling in MB. Per-upload limits are tighter (firmware at
# 64MB is the largest); this bounds what gets buffered at all. Raise alongside
# EMULATOR_BIOS_MAX_BYTES if you raise that.
MAX_UPLOAD_MB=128
# Firmware upload ceiling in bytes. 0 / unset keeps the 64MB default.
EMULATOR_BIOS_MAX_BYTES=0
# Total .cht cheat storage across every game, in bytes. 0 / unset keeps 256MB.
# (Each game is also capped at 200 files of 1MB.)
CHEAT_STORAGE_MAX_BYTES=0
# Optional folder of dumps you already own. Boot imports missing names from here
# (never overwrites). Admin → Emulators can scan the same path (and subfolders).
# BIOS_IMPORT_SOURCE=E:\_bios

# AGPL §13: people using this over a network must be offered the Corresponding
# Source. Surfaced on member Help and in the admin footer.
#
# **If you modify Oneirodex and run it for others, point this at YOUR fork** —
# §13 obliges you to offer your users your source, not upstream's.
ONEIRODEX_SOURCE_URL=https://github.com/cephyrixzyth/oneirodex

# WebRetro libretro cores are provisioned, not shipped — their GPL and
# non-commercial terms make vendoring them the wrong call. On by default; set
# false for air-gapped installs and use
# scripts/fetch-webretro-cores.sh --from-dir instead.

# Browser play engine B (EmulatorJS, BP-2). Host directory holding an EmulatorJS
# release's data/ (loader.js at its root) -- fill with scripts/fetch-emulatorjs.sh.
# Leave empty / absent and the engine is simply not offered.
# EMULATORJS_HOST_PATH=/mnt/cache/appdata/oneirodex/emulatorjs
FETCH_WEBRETRO_CORES_ON_BOOT=true

STEAMGRIDDB_API_KEY=
# Optional Steam Web API key for live ownership register sync (not downloads).
STEAM_WEB_API_KEY=
# Optional household GOG/Epic/Amazon tokens. Prefer per-member tokens on the
# Ownership page. Live sync is unofficial (Galaxy / launcher / Nile) and
# register-only — never downloads. A household token is used only for members
# who link the store WITHOUT their own token, and that account's library is then
# recorded as theirs (the store card and Admin → Store connections say so).
# Replacing a value here supersedes copies refreshed into member rows.
# GOG_REFRESH_TOKEN=
# GOG_ACCESS_TOKEN=
# GOG_CLIENT_ID=
# GOG_CLIENT_SECRET=
# EPIC_DEVICE_AUTH={"account_id":"","device_id":"","secret":""}
# EPIC_CLIENT_ID=
# EPIC_CLIENT_SECRET=
# AMAZON_REFRESH_TOKEN=
# AMAZON_ACCESS_TOKEN=
# AMAZON_DEVICE_SERIAL=
# AMAZON_NILE_JSON=
# Dual names (ADR 0003 P3b). Compose defaults are oneirodex-* container/image
# names. Live Unraid stacks that still run oneirodex-app should pin until FIFO idle:
# APP_IMAGE=oneirodex:1.1.0
# APP_CONTAINER_NAME=oneirodex-app
# DB_CONTAINER_NAME=oneirodex-db
# APP_IMAGE=cephyrixzyth/oneirodex:1.1.0
GIANTBOMB_API_KEY=
# Optional — Class D identify search (GET /api/search_metadata?source=mobygames).
# Empty/missing → honest empty results (no 500). https://www.mobygames.com/info/api/
MOBYGAMES_API_KEY=
# Optional — Class D identify / covers (GET /api/search_metadata?source=thegamesdb|tgdb).
# Empty/missing → honest empty results (no 500). https://thegamesdb.net/api/register.php
THEGAMESDB_API_KEY=
# Optional — RetroAchievements: match cartridge ROMs to community achievement
# sets by hash (Admin → Emulators → RetroAchievements → Match) and read a
# member's progress when they enter their own RA username. Nothing played in
# the browser unlocks anything. Both are needed: the account name that owns
# the web API key (retroachievements.org → Settings → Keys) and the key.
# Empty/missing → honest no data (no badge, no promise).
RETROACHIEVEMENTS_USERNAME=
RETROACHIEVEMENTS_API_KEY=
# Meta/Quest identify: default IGDB Quest platforms. Modes: igdb|csv_only|disabled|unofficial_graphql
META_QUEST_API_MODE=igdb
# Optional — reserved for future official Meta catalog (not required for IGDB identify).
META_GRAPH_ACCESS_TOKEN=
# Explicit opt-in only — never default-on. Unofficial GraphQL stub stays empty.
META_QUEST_UNOFFICIAL_GRAPHQL=0

ENABLE_ARR_MODULE=true
ENABLE_DEBRID=true
ENABLE_GAME_ASSISTS=true
ENABLE_MOD_TRACKING=true
# Companion Flips IPS/BPS apply (needs FLIPS_PATH for actual apply)
ENABLE_ROM_PATCH_APPLY=true
FLIPS_PATH=
# DAT unique-hash: open zip/7z/rar and hash inner dump when outer archive hash misses (default on)
DAT_HASH_INNER_ARCHIVE=true
# How many sources must name a title before the scan auto-imports it (H1d).
# 1 = a high-confidence IGDB match imports on its own (default). 2 = one
# catalogue (Steam/GOG/Moby/TGDB unique-exact) must agree, else -> Review.
# IDENTIFY_AGREEMENT_MIN=1
# Keyless community hash lookup for console ROMs after an IGDB + local-DAT
# miss (INSP-31). Identity only, never a download. Off: ENABLE_HASH_IDENTIFY=false
# ENABLE_HASH_IDENTIFY=true
# HASH_IDENTIFY_BASE_URL=https://hasheous.org
# Operator-owned patch guide catalog (YAML/JSON). No third-party DB scrape.
ENABLE_PATCH_CATALOG=true
PATCH_CATALOG_PATH=
# RetroArch AI Service overlay hints (companion / native RetroArch only)
ENABLE_ROM_AI_TRANSLATE=true
RETROARCH_AI_SERVICE_URL=
ENABLE_ACTIVITY_FEED=true
ENABLE_FREE_GAMES=true
# BYO notification bus (INSP-6): push the admin alerts you already get in-app
# to a phone through services you run. Nothing bundled. Apprise API notify
# URL(s), comma list — e.g. http://apprise:8000/notify/oneirodex — and/or an
# ntfy topic URL. Social kinds (friend requests, mentions, DMs, free games)
# stay in-app unless NOTIFY_SOCIAL_TO_BUS=true; they still respect each
# member's own notification preferences.
# NOTIFY_APPRISE_URLS=
# NOTIFY_NTFY_URL=https://ntfy.sh/your-private-topic
# NOTIFY_SOCIAL_TO_BUS=false
# Unofficial, register-only store sync (INSP-42). Comma list of stores whose
# *live* sync you opt into: xbox, psn (or "all"). Unset = CSV snapshot only.
# Each also needs its optional client (requirements-optional.txt) and a token
# the member places on the Ownership page — never in this file.
# ENABLE_UNOFFICIAL_STORE_SYNC=
# XBOX_TOKENS_JSON=        household fallback: the xbox-webapi tokens JSON
# XBOX_CLIENT_ID= / XBOX_CLIENT_SECRET=   your own Azure app registration
# PSN_NPSSO=               household fallback npsso
# Where a PC game keeps its saves (INSP-1): one keyless fetch a day of the
# community save-location manifest, indexed into static/library/save_paths/.
# The details page shows the folder; the companion can open it. Nothing is
# synced or copied. Off hides the row everywhere.
ENABLE_SAVE_PATHS=true
# SAVE_PATHS_MANIFEST_URL=https://raw.githubusercontent.com/mtkennerly/ludusavi-manifest/master/data/manifest.yaml
# SAVE_PATHS_CACHE_DIR=
# GPU pulse on Admin → Ops (INSP-44). Oneirodex bundles no sensor tool and no
# driver: it reads NVIDIA's library when the optional pynvml package and a
# device are present, else a BYO reader you run on a household PC —
# LibreHardwareMonitor / HWiNFO-class JSON — at this URL, read-only.
# TELEMETRY_READER_URL=http://gaming-pc:8085/data.json
# Browse public mod registries (Thunderstore, Modrinth) from a game's Mods
# panel (INSP-22). Read-only: names, versions, loaders and registry pages;
# never a download. Off hides the Browse catalogue button.
ENABLE_MOD_CATALOG=true
# Nexus Mods browse (trending + latest) needs a personal API key from your
# Nexus account page. Browse only — never a download. Leave empty to skip.
NEXUS_API_KEY=
# Community anti-cheat compatibility (INSP-35). One keyless fetch a day of the
# public list into static/library/anticheat/; the details page shows the status
# as *community reports*, never a guarantee. Off hides the row everywhere.
ENABLE_ANTICHEAT_COMPAT=true
# ANTICHEAT_FEED_URL=https://raw.githubusercontent.com/AreWeAntiCheatYet/AreWeAntiCheatYet/HEAD/games.json
# ANTICHEAT_CACHE_PATH=
# Look a giveaway's cover up on IGDB when the store has no portrait URL of its
# own (GOG, itch, Humble, IndieGala, Epic via GamerPower). Cached for a month,
# so roughly one call per new title. Off keeps the aggregator's wide banner.
ENABLE_FREE_GAMES_COVER_LOOKUP=true
# Which sites the News page pulls gaming headlines from. Replaces the built-in
# list entirely; comma or pipe separated. http(s) only — the server fetches
# these, so anything else is refused and the defaults are kept.
#   ONEIRODEX_NEWS_FEEDS=https://www.polygon.com/rss/index.xml,https://www.pcgamer.com/rss/
ONEIRODEX_NEWS_FEEDS=
FREE_GAMES_POLL_HOURS=3

# Discover's on-box recommender: taste profiles and title similarity, rebuilt on
# a schedule. Everything is derived from signals this install already stores and
# nothing leaves the box. Turn it off and Discover keeps working — the rows that
# depend on it simply do not appear.
ENABLE_DISCOVER_ML=true
# Hours between rebuilds (clamped 1-168). Taste moves slowly; nightly is ample.
DISCOVER_ML_REBUILD_HOURS=24
# Batched email digest (unread mentions/DMs/free games); needs Admin SMTP + member opt-in
ENABLE_EMAIL_DIGEST=true
EMAIL_DIGEST_INTERVAL_HOURS=24
ENABLE_LOGIN_RATE_LIMIT=true
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ENABLE_PCDOS_BROWSER=true
# ENABLE_RUFFLE — read by utils/ruffle_play but nothing calls it, and the Ruffle
# player is not vendored. Left here (and in config.py) so the plumbing survives,
# but the admin toggle was removed: it could not change anything.
ENABLE_RUFFLE=true
# Malware scan (ClamAV when reachable + filename heuristics)
ENABLE_MALWARE_SCAN=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SOCKET=
MALWARE_SCAN_BLOCK_ON_HIT=true
REAL_DEBRID_TOKEN=
ALLDEBRID_API_KEY=
PREMIUMIZE_API_KEY=
TORBOX_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=
JACKETT_URL=
JACKETT_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
TRANSMISSION_URL=
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
DELUGE_URL=
DELUGE_PASSWORD=
SABNZBD_URL=
SABNZBD_API_KEY=
NZBGET_URL=
NZBGET_USERNAME=
NZBGET_PASSWORD=

ENCRYPT_EMULATOR_SAVES=false

ENABLE_AI_ASSIST=true
ENABLE_AI_AUTO_APPLY=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Generated cover art — off by default. Point at your OWN endpoint; the a1111
# engine speaks the API that AUTOMATIC1111, SD.Next and Forge all implement.
# Nothing leaves your network and there is no key to buy.
# The endpoint does not have to be this machine: a GPU box elsewhere on the
# LAN is just a different URL here. GPU for the bundled sidecar is opt-in via
# docker-compose.gpu.yml — never requested by default, because reserving one
# on a host with no NVIDIA driver fails container create outright.
ENABLE_AI_ARTWORK=false
AI_ARTWORK_URL=
AI_ARTWORK_ENGINE=a1111

# Check version / updates / DLC after a library scan. Off by default because
# each check is outbound store HTTP traffic; the limit caps a big first scan.
SCAN_CHECK_FRESHNESS=false
SCAN_FRESHNESS_LIMIT=50

# Theme fonts. Empty FONT_PATH = oneirodex/static/library/fonts.
# Font files are operator-supplied — see docs/admin/theme-fonts-and-images.md
FONT_PATH=
FONT_MAX_BYTES=8388608

ENABLE_HARDLINK_HELPERS=true
ALLOW_HARDLINK_APPLY=false
ENABLE_ARR_HARDLINK_PIPELINE=true
# Remote path mapping — set this when your download client runs in a different
# container than Oneirodex. qBittorrent reports paths from ITS mounts, so
# without a mapping the hardlink pipeline stats a path that does not exist here
# and reports "no source file found" even though the file is present.
# Format: "remote=>local" pairs joined by "|".
#   ARR_REMOTE_PATH_MAP=/downloads=>/storage/downloads|/data/torrents=>/mnt/user/torrents
ARR_REMOTE_PATH_MAP=


ENABLE_VR_BROWSE=true

# Homelab — allow *arr/Ollama connector URLs on RFC1918 LAN (metadata IP still blocked)
ALLOW_PRIVATE_LAN_URLS=true
# Do not overwrite existing user roles from OIDC groups on each login (default on)
OIDC_LOCK_ROLES=true
# SSO links an existing account only by a provider-verified email (email_verified),
# then by the provider's subject. Set true only if your provider omits
# email_verified and its admins (not users) set every address.
OIDC_TRUST_PROVIDER_EMAIL=false

# BYO challenge / captcha solver sidecar (FlareSolverr-compatible TRAWL) — opt-in only
# Compose profile `challenge` (Ops) + CHALLENGE_SOLVER_URL=http://trawl:8191 when sidecar is up
ENABLE_CHALLENGE_SOLVER=false
CHALLENGE_SOLVER_URL=
CHALLENGE_SOLVER_PROVIDER=flaresolverr_compat
CHALLENGE_SOLVER_TIMEOUT_MS=60000
CHALLENGE_SOLVER_MAX_TIER=5
# Optional token CAPTCHA API (CapSolver-style) when provider=token_api
CHALLENGE_TOKEN_API_URL=
CHALLENGE_TOKEN_API_KEY=

# LiveKit voice (on by default; needs secrets + compose profile `livekit` for SFU)
# LiveKit no longer runs in --dev mode, so there is no built-in devkey/secret.
# Generate a pair; the app and the SFU read these same two values:
#   python -c "import secrets; print('LIVEKIT_API_KEY=odx' + secrets.token_hex(6)); print('LIVEKIT_API_SECRET=' + secrets.token_hex(32))"
# Alphanumerics only, secret at least 32 characters. Left blank, the livekit
# container refuses to start (by design) instead of running open on :7880.
ENABLE_LIVEKIT=true
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# BYO Sunshine / Wolf remote play (Moonlight clients) — opt-in only
ENABLE_REMOTE_PLAY=false
SUNSHINE_BASE_URL=
WOLF_BASE_URL=
REMOTE_PLAY_PROVIDER=sunshine
REMOTE_PLAY_HOST_LABEL=
REMOTE_PLAY_APP_HINT=
REMOTE_PLAY_PIN_HINT=
REMOTE_PLAY_TOKEN_HINT=

# Ambient lighting bridge (Hyperion.ng / Home Assistant) — opt-in only
ENABLE_AMBIENT_LIGHTING=false
LIGHTING_PROVIDER=off
# Hyperion direct: http://192.168.x.x:8090  (requires ALLOW_PRIVATE_LAN_URLS=true)
HYPERION_URL=
HYPERION_TOKEN=
HYPERION_PRIORITY=50
AMBIENT_ACCENT_COLOR=255,128,32
# Home Assistant REST: long-lived token + entity/scene ids
HA_URL=
HA_TOKEN=
HA_LIGHT_ENTITIES=
HA_PLAY_SCENE=
HA_STOP_SCENE=

# In-app support → GitHub Issues (PAT with issues:write; skip sync if unset)
SUPPORT_GITHUB_TOKEN=
SUPPORT_GITHUB_REPO=cephyrixzyth/oneirodex

# --- Challenge / captcha solver (opt-in — default OFF) ---
# Enable only when you run TRAWL/FlareSolverr and need JS/captcha bypass for acquire.
# Compose: docker compose --profile challenge up -d  then set URL below.
ENABLE_CHALLENGE_SOLVER=false
# With Compose profile `challenge`: CHALLENGE_SOLVER_URL=http://trawl:8191
# External LAN solver: http://192.168.x.x:8191  (requires ALLOW_PRIVATE_LAN_URLS=true)
CHALLENGE_SOLVER_URL=
CHALLENGE_SOLVER_PROVIDER=flaresolverr_compat
CHALLENGE_SOLVER_TIMEOUT_MS=60000
CHALLENGE_SOLVER_MAX_TIER=5
# Old NAS CPU / kernel <5.1 — set in .env when using Compose profile (not read by app):
# TRAWL_IMAGE=ghcr.io/germondai/trawl:baseline
